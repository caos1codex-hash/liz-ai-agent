# Maintainer: caos1codex-hash <caos1codex-hash@users.noreply.github.com>
# Fase 10 — Release v0.1.0
#
# PKGBUILD para AUR (Arch User Repository):
#   https://aur.archlinux.org/packages/liz-ai-agent
#
# Construir e instalar:
#   makepkg -si
#
# O subir a AUR:
#   makepkg --printsrcinfo > .SRCINFO
#   git clone aur@aur.archlinux.org:liz-ai-agent.git
#   cp PKGBUILD .SRCINFO liz-ai-agent/
#   cd liz-ai-agent && git add -A && git commit -m "v0.1.0" && git push

pkgname=liz-ai-agent
pkgver=0.10.0
pkgrel=1
pkgdesc="Agente de IA autónomo para Linux — control total del sistema mediante lenguaje natural (Claude Code + Cursor + Aider + Google Assistant en un binario)"
arch=('x86_64')
url="https://github.com/caos1codex-hash/liz-ai-agent"
license=('MIT')
depends=(
    'glibc'
    'mesa'
    'libx11'
    'libxrandr'
    'libxinerama'
    'libxcursor'
    'libxi'
    'libxxf86vm'
    'wayland'
    'libxkbcommon'
)
makedepends=(
    'go'
    'git'
    'pkgconf'
)
optdepends=(
    'nvidia-container-toolkit: para usar modelos NVIDIA si se ejecuta en contenedor'
)
source=("${pkgname}::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')  # Cambiar por SHA256 real al publicar

build() {
    cd "${srcdir}/${pkgname}"

    # CGO habilitado para Fyne (GUI OpenGL)
    export CGO_ENABLED=1
    export GOFLAGS="-trimpath -mod=readonly -modcacherw"
    export LDFLAGS="-s -w -X main.version=${pkgver}"

    go build -ldflags="${LDFLAGS}" -o liz ./cmd/liz

    # También compilar el binario headless (estático, sin OpenGL deps)
    CGO_ENABLED=0 go build -tags headless -ldflags="${LDFLAGS}" -o liz-server ./cmd/liz
}

check() {
    cd "${srcdir}/${pkgname}"
    # Tests que no requieren OpenGL
    CGO_ENABLED=0 go test -tags headless -short ./internal/nucleo/logger/... \
        ./internal/nucleo/config/... ./internal/nucleo/permisos/... \
        ./internal/nucleo/memoria/... ./internal/nucleo/orquestador/... \
        ./internal/nucleo/herramientas/... || true
}

package() {
    cd "${srcdir}/${pkgname}"

    # Binarios
    install -Dm755 liz "${pkgdir}/usr/bin/liz"
    install -Dm755 liz-server "${pkgdir}/usr/bin/liz-server"

    # Config de ejemplo
    install -Dm644 configs/liz.yaml.example "${pkgdir}/etc/liz/config.yaml.example"

    # Documentación
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 CHANGELOG.md "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" 2>/dev/null || true

    # Entrada de menú
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/liz.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Liz AI Agent
Comment=Agente de IA autónomo para Linux
Exec=/usr/bin/liz
Icon=utilities-terminal
Terminal=false
Categories=Development;System;Utility;
StartupNotify=true
Keywords=ai;agent;llm;nvidia;
EOF

    # Scripts de shell
    install -Dm755 scripts/install.sh "${pkgdir}/usr/share/${pkgname}/install.sh"
    install -Dm755 scripts/uninstall.sh "${pkgdir}/usr/share/${pkgname}/uninstall.sh"
}

# vim: set ts=4 sw=4 et:
